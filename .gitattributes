# 统一换行符, 避免 Windows 检出的 CRLF 在 diff 中产生噪声
* text=auto eol=lf

# Windows 专用脚本保留 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# 二进制文件不做换行符转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.jar binary
*.gz binary
*.ttf binary
*.otf binary

# 语言统计修正: 生成的词典数据不计入代码行数统计
lib/core/kanji_reading_dict.dart linguist-generated=true

# 截图在 GitHub 上按图片展示
docs/** linguist-documentation=true
